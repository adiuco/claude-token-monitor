{
  // "image": Specifies the Docker image to use as the base for your development container.
  // This is where your container starts, providing the operating system and base tools.
  // Reference: https://containers.dev/implementors/json_reference/#image
  "image": "mcr.microsoft.com/devcontainers/base:debian",

  // "runArgs": Provides an array of additional arguments to pass to the `docker run` command
  // when creating the container. This is useful for setting specific Docker options.
  // Here, "--privileged" grants the container extended capabilities, often needed for
  // nested virtualization or certain advanced scenarios like Docker-in-Docker.
  // Reference: https://containers.dev/implementors/json_reference/#runargs
  "runArgs": ["--privileged"],

  // "features": Defines a set of pre-built, reusable components that can be added to your
  // dev container to quickly include tools, languages, or runtime environments.
  // Each feature is specified by its ID (e.g., "ghcr.io/devcontainers/features/rust:1")
  // and can have optional configuration.
  // Reference: https://containers.dev/implementors/features/
  "features": {
    // Adds Rust programming language and its associated tools.
    "ghcr.io/devcontainers/features/rust:1": {},
    // Installs Docker within the development container, allowing you to build and run
    // Docker images directly inside your dev environment.
    // "version": "latest" ensures the most recent Docker version is installed.
    // "enableNonRootDocker": "true" allows non-root users to interact with Docker,
    // which is a good security practice.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true"
    },
    // Adds Node.js and npm/yarn for JavaScript development.
    "ghcr.io/devcontainers/features/node:1": {},
    // Adds Python and its package management tools (pip).
    "ghcr.io/devcontainers/features/python:1": {}
  },

  // "customizations": Allows you to apply specific configurations to tools and applications
  // within the dev container. This is commonly used for IDE settings.
  // Reference: https://containers.dev/implementors/json_reference/#customizations
  "customizations": {
    // "vscode": Specifically for Visual Studio Code, allowing you to configure settings
    // and install extensions that will be active when you open the dev container in VS Code.
    "vscode": {
      // "settings": An object where you can define VS Code user settings.
      // These settings will override your local VS Code settings for this specific dev container.
      // Reference: https://code.visualstudio.com/docs/getstarted/settings
      "settings": {},
      // "extensions": An array of VS Code extension IDs that will be automatically installed
      // when the dev container is created or opened. This ensures all developers working
      // on the project have the same essential tools.
      // Reference: https://code.visualstudio.com/api/references/extension-manifest
      "extensions": [
        "bierner.markdown-mermaid", // For Mermaid diagrams in Markdown
        "shd101wyy.markdown-preview-enhanced", // Enhanced Markdown preview
        "rust-lang.rust-analyzer", // Rust language support
        "serayuzgur.crates", // Rust Cargo.toml dependency helper
        "bungcip.better-toml", // TOML file support (used by Rust Cargo)
        "ms-vscode.vscode-node-azure-pack", // Azure tools for Node.js
        "ms-vscode.vscode-json", // JSON language features
        "bradlc.vscode-tailwindcss", // Tailwind CSS IntelliSense
        "esbenp.prettier-vscode", // Code formatter
        "ms-vscode.test-adapter-converter", // Test adapter compatibility
        "hbenl.vscode-test-explorer", // Test exploration UI
        "ms-vscode.js-debug", // JavaScript debugger
        "ms-vscode.vscode-typescript-next", // Latest TypeScript features
        "ms-python.python", // Python language support and debugging
        "ms-vscode.vscode-docker" // Docker extension for managing containers
      ]
    }
  },

  // "postCreateCommand": A command or script that runs once after the dev container
  // is successfully created and started for the first time. This is ideal for
  // installing project dependencies, setting up environment variables, or running
  // initial build steps.
  // Here, it updates npm, installs Node.js project dependencies with yarn, and
  // fetches Rust project dependencies with cargo.
  // Reference: https://containers.dev/implementors/json_reference/#lifecycle-scripts
  "postCreateCommand": "npm install -g npm@latest && yarn install && cargo fetch",

  // "workspaceFolder": Defines the path inside the container where your project files
  // will be mounted. This is the directory that VS Code (or your IDE) will open by default.
  // Reference: https://containers.dev/implementors/json_reference/#workspacefolder
  "workspaceFolder": "/workspace",

  // "mounts": An array of Docker bind mounts or volume mounts to apply to the container.
  // This allows you to share files or directories between your host machine and the container,
  // or between different containers.
  // Here, it mounts the Docker daemon's socket from the host to the container.
  // This is crucial for the "docker-in-docker" feature to work, as it allows the
  // Docker client inside the container to communicate with the Docker daemon on the host.
  // Reference: https://containers.dev/implementors/json_reference/#mounts
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"]
}